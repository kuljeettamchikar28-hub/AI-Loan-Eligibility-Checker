# Optional: when absent, LoanWise AI runs in clearly labeled mock mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Configure either an Apps Script web-app URL or the service-account path described in README.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Restrict browser-origin access in a deployed environment.
ALLOWED_ORIGIN=https://your-public-domain.example
RATE_LIMIT_PER_MINUTE=20
PORT=3000
